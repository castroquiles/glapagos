# GLAPAGOS Environment Configuration
# Copy to .env and fill in values for local development.
# Never commit .env to the repository.

GLAPAGOS_ENV=development

# Database
DATABASE_URL=postgresql://glapagos:password@localhost:5432/glapagos_dev

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Security
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-key

# External services (leave blank if not using locally)
COMPUTE_BROKER_URL=
