{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glapagos.ai/schemas/dataset-manifest-v1.json",
  "title": "GLAPAGOS Dataset Manifest",
  "description": "Required manifest for datasets contributed to the GLAPAGOS Data Commons",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "license",
    "languages",
    "provenance",
    "maintainers"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique dataset identifier, lowercase, hyphens only"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version"
    },
    "description": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "es": { "type": "string" },
        "pt": { "type": "string" },
        "fr": { "type": "string" }
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "BCP 47 language codes covered by this dataset"
    },
    "countries": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ISO 3166-1 alpha-2 country codes"
    },
    "provenance": {
      "type": "object",
      "required": ["source", "collection_method", "collection_date_range"],
      "properties": {
        "source": { "type": "string" },
        "collection_method": { "type": "string" },
        "collection_date_range": {
          "type": "object",
          "required": ["start"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "indigenous_data": {
      "type": "object",
      "properties": {
        "contains_indigenous_data": { "type": "boolean" },
        "consent_documentation": { "type": "string" },
        "community_governance_body": { "type": "string" },
        "benefit_sharing_mechanism": { "type": "string" }
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "affiliation"],
        "properties": {
          "name": { "type": "string" },
          "affiliation": { "type": "string" },
          "github": { "type": "string" }
        }
      }
    },
    "size": {
      "type": "object",
      "properties": {
        "records": { "type": "integer" },
        "bytes": { "type": "integer" }
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  }
}
